{
  "mcpServers": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/yourname/projects"
      ]
    },
    "postgres": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres"],
      "env": {
        "POSTGRES_CONNECTION_STRING": "${DATABASE_URL}"
      }
    }
  }
}

// Save this to:
//   ~/.claude/mcp.json           (global — all projects)
//   .claude/mcp.json             (project-level — this project only)
//
// Environment variables like ${GITHUB_TOKEN} must be set in your shell.
// They are NOT stored in the config file.
//
// Add a server interactively: claude mcp add
// List connected servers:      claude mcp list
// Remove a server:             claude mcp remove github
